{
  "name": "ros-rcs",
  "private": true,
  "version": "0.1.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,desktop -c cyan,yellow \"npm run dev:web\" \"npm run dev:desktop\"",
    "dev:web": "npm run dev --workspace @rcs/web",
    "dev:desktop": "wait-on tcp:5173 && cross-env RCS_RENDERER_URL=http://127.0.0.1:5173 electron apps/desktop/src/main.mjs",
    "build": "npm run build --workspace @rcs/web",
    "typecheck": "npm run typecheck --workspace @rcs/web"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
